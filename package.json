{
  "name": "nexgenedu",
  "version": "0.1.0",
  "private": true,
  "description": "辅导机构轻量化管理系统 V1 —— 对外宣传网站（静态站） + 教务后台（本机 Node + SQLite）",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run sync-content && npm run sync-site-data && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sync-content": "node scripts/sync-content.mjs",
    "check": "node --experimental-strip-types scripts/check.mjs",
    "check:404": "node scripts/check-404.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:all": "npm run check && npm run check:404 && npm run check:links",
    "check:both": "node --experimental-strip-types --import ./server/loader.mjs scripts/check-both.mts",
    "check:auth": "node --experimental-strip-types --import ./server/loader.mjs scripts/check-auth.mts",
    "server": "node --experimental-strip-types --import ./server/loader.mjs server/index.mts",
    "server:migrate": "node --experimental-strip-types --import ./server/loader.mjs server/migrate.mts",
    "server:health": "curl -s http://localhost:4000/health",
    "server:import": "node --experimental-strip-types --import ./server/loader.mjs server/import-data.mts",
    "accept": "node --experimental-strip-types --import ./server/loader.mjs scripts/accept-run.mts",
    "server:backup": "node --experimental-strip-types --import ./server/loader.mjs server/backup-cli.mts",
    "drill:restore": "node --experimental-strip-types --import ./server/loader.mjs scripts/drill-restore.mts",
    "bench:capacity": "node --experimental-strip-types --import ./server/loader.mjs scripts/bench-capacity.mts",
    "sync-site-data": "node scripts/sync-site-data.mjs",
    "holidays:fetch": "node --experimental-strip-types --import ./server/loader.mjs scripts/fetch-holidays.mts",
    "site:snapshot": "node scripts/site-snapshot.mjs",
    "site:diff": "node --experimental-strip-types --import ./server/loader.mjs scripts/diff-site-content.mts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
